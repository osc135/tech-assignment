/* Main container — fills the screen */
.table-root {
    flex-grow: 1;
    position: relative;
}

/* ── Top bar ──────────────────────────────────── */
.top-bar {
    flex-direction: row;
    align-items: center;
    padding: 8px 20px;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
}

.top-bar-left {
    flex-direction: row;
    align-items: center;
    position: absolute;
    left: 20px;
}

.top-bar-right {
    position: absolute;
    right: 20px;
    align-items: flex-end;
}

.hud-title {
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgba(255, 255, 255, 0.6);
}

.hud-phase {
    flex-grow: 1;
    -unity-text-align: middle-center;
    font-size: 14px;
    color: var(--color-gold);
    -unity-font-style: bold;
}

.connection-status {
    font-size: 9px;
    color: var(--color-text-muted);
    margin-left: 10px;
}

.connection-status.connected {
    color: var(--color-green);
}

.connection-status.disconnected {
    color: var(--color-error);
}

.error-message {
    font-size: 10px;
    color: var(--color-error);
}

/* ── Table area — fills the screen ────────────── */
.table-area {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

/* Felt surface — large, centered */
.felt {
    position: absolute;
    top: 60px;
    left: 80px;
    right: 80px;
    bottom: 50px;
    background-color: var(--color-felt);
    border-radius: 50%;
    border-width: 10px;
    border-color: var(--color-felt-border);
    align-items: center;
    justify-content: center;
    flex-direction: column;
}

/* Inner ring for depth */
.felt-inner {
    position: absolute;
    top: 16px;
    left: 28px;
    right: 28px;
    bottom: 16px;
    border-radius: 50%;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
    background-color: rgba(255, 255, 255, 0.02);
}

/* Community cards area */
.community-cards {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-bottom: 10px;
    min-height: 62px;
}

.community-cards .card {
    margin-left: 3px;
    margin-right: 3px;
}

/* Pot display */
.pot-label {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--color-gold);
}

/* ── Controls — bottom right corner ──────────── */
.controls {
    position: absolute;
    bottom: 10px;
    right: 16px;
    flex-direction: row;
    align-items: center;
}

.controls Button {
    padding: 6px 16px;
    border-radius: 5px;
    font-size: 11px;
    -unity-font-style: bold;
    margin-left: 4px;
    border-width: 0;
}

.btn-step {
    background-color: rgb(76, 175, 80);
    color: white;
}

.btn-step:hover {
    background-color: rgb(56, 155, 60);
}

.btn-step:disabled {
    opacity: 0.4;
}

.btn-auto {
    background-color: rgb(33, 150, 243);
    color: white;
}

.btn-auto:hover {
    background-color: rgb(13, 130, 223);
}

.btn-auto.running {
    background-color: rgb(244, 67, 54);
}

.btn-speed {
    background-color: rgb(68, 68, 68);
    color: rgb(204, 204, 204);
    font-size: 10px;
    padding: 6px 10px;
}

/* ── Hand History ───────────────────────────── */
.btn-history {
    background-color: rgb(85, 85, 85);
    color: rgb(204, 204, 204);
}

.btn-history.active {
    background-color: rgb(33, 150, 243);
    color: white;
}

.history-panel {
    position: absolute;
    bottom: 40px;
    right: 0;
    width: 320px;
    height: 280px;
    background-color: rgba(12, 12, 28, 0.95);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    flex-direction: column;
}

.history-header {
    padding: 6px 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.history-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--color-text-muted);
}

.history-scroll {
    flex-grow: 1;
    padding: 4px 8px;
}

.history-entry {
    font-size: 10px;
    color: var(--color-text);
    padding: 2px 0;
    white-space: normal;
}

.history-spacer {
    height: 8px;
}
